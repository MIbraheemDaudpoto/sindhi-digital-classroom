# ==============================================================================
# Sindhi Digital Classroom (SDC) — Production Environment Configuration
# ==============================================================================

# Core Application
APP_NAME="Sindhi Digital Classroom (SDC)"
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security (MUST be at least 32 characters long in production)
SECRET_KEY="sdc-prod-secret-replace-with-cryptographic-random-key-64-characters-long"
CORS_ALLOWED_ORIGINS="https://your-domain.com,https://sindhi-digital-classroom.onrender.com"

# Database (SQLite with Write-Ahead Logging & Foreign Keys)
DATABASE_PATH="/app/data/sdc_platform.db"

# AI Inference & LLM Configuration
# Options: "auto" (probes Ollama, falls back to fast local CPU neural/curriculum), "ollama", "neural"
AI_PROVIDER=auto
AI_MODEL_NAME=sdc-sindhillm-1b-science
OLLAMA_ENDPOINT_URL=http://127.0.0.1:11434/v1
OLLAMA_DEFAULT_MODEL=llama3.2:1b
AI_INFERENCE_TIMEOUT_SECONDS=15.0

# Storage & Media CDN
# Leave blank to serve local media, or point to Backblaze B2 / Cloudflare CDN
MEDIA_CDN_URL=""

# Rate Limiting Guardrails
RATE_LIMIT_ENABLED=true
RATE_LIMIT_OTP_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_MINUTE=10

