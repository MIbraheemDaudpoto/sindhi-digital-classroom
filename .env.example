# Copy to .env for local use. Never commit real secrets.
APP_NAME=Sindhi Digital Classroom (SDC)
ENVIRONMENT=development
DEBUG=False
HOST=0.0.0.0
PORT=8000
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Use a durable mounted volume in a hosted environment; local SQLite is not
# suitable on an ephemeral filesystem or for multiple concurrent app replicas.
DATABASE_PATH=data/sdc_platform.db
CORS_ALLOWED_ORIGINS=
MEDIA_ROOT=media
OFFLINE_PACKS_ROOT=media/offline_packs

# Supported configured providers are not proof of successful live inference.
# Select only a provider/model that is actually reachable and record request-level
# inference provenance. Keep AI_PROVIDER=neural for the local model setup.
AI_PROVIDER=neural
AI_MODEL_NAME=sdc-sindhillm-1b-science
LOCAL_MODEL_DIR=models/sdc-sindhillm-1b-science
AI_ENDPOINT_URL=
AI_API_KEY=
HF_API_TOKEN=
AI_INFERENCE_TIMEOUT_SECONDS=30
GROUNDING_CONFIDENCE_THRESHOLD=0.65

# SMS is not used for student registration. Registration requires an admin-issued
# single-use invite. SMS is optional for password recovery and must not be mocked
# or represented as delivered in production.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=SDC-Alert
SMS_ENDPOINT_URL=

SESSION_EXPIRY_SECONDS=86400
PASSWORD_RESET_TOKEN_EXPIRY_SECONDS=600
ALLOW_TEST_QUERY_AUTH=False
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_OTP_PER_MINUTE=5

# Production requirements: ENVIRONMENT=production, a unique SECRET_KEY with at
# least 32 characters, explicit CORS_ALLOWED_ORIGINS when cross-origin is used,
# durable database/media storage, tested backup and restore, and verified model
# inference. This example intentionally does not select or deploy a host.
